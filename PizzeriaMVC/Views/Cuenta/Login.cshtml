@model PizzeriaMVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Ingresar";
}

<h2 class="titulo-seccion mb-4 text-center">Ingresar</h2>

<div class="row g-4 justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="seccion-datos">
            <form asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Correo">Correo</label>
                    <input class="form-control text-center" asp-for="Correo" placeholder="juan@correo.com" />
                    <span class="text-danger" asp-validation-for="Correo"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label" asp-for="Contrasena">Contraseña</label>
                    <input class="form-control text-center" asp-for="Contrasena" type="password" placeholder="Tu contraseña" />
                    <span class="text-danger" asp-validation-for="Contrasena"></span>
                </div>

                <button type="submit" class="btn btn-pizza-verde btn-lg w-100">Ingresar</button>
            </form>

            <p class="mt-3 mb-0 text-center">¿No tenés cuenta? <a asp-action="Registro">Registrate acá</a>.</p>
        </div>
    </div>
</div>
