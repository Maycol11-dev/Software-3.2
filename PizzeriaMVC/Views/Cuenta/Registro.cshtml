@model PizzeriaMVC.Models.RegistroViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<h2 class="titulo-seccion mb-4 text-center">Crear cuenta</h2>

<div class="row g-4 justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="seccion-datos">
            <form asp-action="Registro" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Correo">Correo</label>
                    <input class="form-control text-center" asp-for="Correo" placeholder="juan@correo.com" />
                    <span class="text-danger" asp-validation-for="Correo"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Contrasena">Contraseña</label>
                    <input class="form-control text-center" asp-for="Contrasena" placeholder="Mínimo 6 caracteres" />
                    <span class="text-danger" asp-validation-for="Contrasena"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Nombre">Nombre</label>
                    <input class="form-control text-center" asp-for="Nombre" placeholder="Juan Pérez" />
                    <span class="text-danger" asp-validation-for="Nombre"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Telefono">Teléfono</label>
                    <input class="form-control text-center" asp-for="Telefono" placeholder="11 2345-6789" />
                    <span class="text-danger" asp-validation-for="Telefono"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label" asp-for="Direccion">Dirección de entrega</label>
                    <input class="form-control text-center" asp-for="Direccion" placeholder="Av. Siempre Viva 123" />
                    <span class="text-danger" asp-validation-for="Direccion"></span>
                </div>

                <button type="submit" class="btn btn-pizza-verde btn-lg w-100">Crear cuenta</button>
            </form>

            <p class="mt-3 mb-0 text-center">¿Ya tenés cuenta? <a asp-action="Login">Ingresá</a>.</p>
        </div>
    </div>
</div>
