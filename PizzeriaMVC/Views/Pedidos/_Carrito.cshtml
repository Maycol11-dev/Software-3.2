@model PizzeriaMVC.Models.CarritoViewModel

<h5 class="fw-bold titulo-seccion mb-3">Tu pedido</h5>

@if (Model.Vacio)
{
    <p class="cart-empty mb-0">Tu carrito está vacío. ¡Agregá algo rico del menú!</p>
}
else
{
    @foreach (var item in Model.Items)
    {
        <div class="d-flex justify-content-between align-items-center py-2 border-bottom card-carrito-item">
            <div>
                <div class="fw-semibold">@item.Nombre <span class="qty text-muted">x @item.Cantidad</span></div>
                <small class="text-muted">@item.Subtotal.ToString("C0", new System.Globalization.CultureInfo("es-AR"))</small>
            </div>
            <form asp-action="Quitar" method="post">
                <input type="hidden" name="id" value="@item.IdPizza" />
                <button class="btn btn-sm btn-outline-danger">✕</button>
            </form>
        </div>
    }

    <div class="d-flex justify-content-between fw-bold mt-3">
        <span>Total</span>
        <span class="precio">@Model.Total.ToString("C0", new System.Globalization.CultureInfo("es-AR"))</span>
    </div>

    <a class="btn btn-pizza-verde w-100 mt-3" asp-action="Confirmar">Confirmar pedido →</a>
}
