@model PizzeriaMVC.Models.MenuViewModel
@{
    ViewData["Title"] = "Menú";
}

@section Styles {
    <link rel="stylesheet" href="~/css/menu.css" asp-append-version="true" />
}

<form id="afToken" class="d-none">@Html.AntiForgeryToken()</form>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="titulo-seccion m-0">Nuestro menú</h2>
    @if (User.IsInRole("Administrador"))
    {
        <a asp-controller="Menu" asp-action="Nueva" class="btn btn-pizza d-inline-flex align-items-center gap-2 rounded-pill px-3 shadow-sm">
            <span>➕</span>
            <span>Nueva pizza</span>
        </a>
    }
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="row g-4">
            @foreach (var pizza in Model.Pizzas)
            {
                var cantidad = Model.Carrito.Items.FirstOrDefault(i => i.IdPizza == pizza.IdPizza)?.Cantidad ?? 0;
                <div class="col-md-6">
                    <div class="card card-pizza h-100 position-relative">
                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-controller="Menu" asp-action="Editar" asp-route-id="@pizza.IdPizza"
                               class="btn btn-light btn-sm shadow-sm position-absolute top-0 end-0 m-2 rounded-circle d-flex align-items-center justify-content-center"
                               style="width: 38px; height: 38px; z-index: 2; opacity: 0.95;"
                               title="Editar pizza">
                                ✏️
                            </a>
                        }
                        <img src="@pizza.ImagenUrl" alt="@pizza.Nombre" class="pizza-img" />
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                <h5 class="fw-bold mb-0">@pizza.Nombre</h5>
                            </div>
                            <p class="text-muted mb-3">@pizza.Descripcion</p>

                            <div class="d-flex justify-content-between align-items-center mt-auto flex-wrap gap-2">
                                <span class="precio">@pizza.Precio.ToString("C0", new System.Globalization.CultureInfo("es-AR"))</span>

                                <div class="qty-pill">
                                    <button type="button" class="btn-qty" data-id="@pizza.IdPizza" data-delta="-1" title="Quitar una">−</button>
                                    <span class="qty-val" data-id="@pizza.IdPizza">@cantidad</span>
                                    <button type="button" class="btn-qty" data-id="@pizza.IdPizza" data-delta="1" title="Agregar una">+</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="cart-sidebar" id="carrito">
            @await Html.PartialAsync("_Carrito", Model.Carrito)
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/carrito.js" asp-append-version="true"></script>
}
