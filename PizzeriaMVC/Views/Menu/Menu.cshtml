@model PizzeriaMVC.Models.MenuViewModel
@{
    ViewData["Title"] = "Menú";
}

@section Styles {
    <link rel="stylesheet" href="~/css/menu.css" asp-append-version="true" />
}

<form id="afToken" class="d-none">@Html.AntiForgeryToken()</form>

<h2 class="titulo-seccion mb-4">Nuestro menú</h2>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="row g-4">
            @foreach (var pizza in Model.Pizzas)
            {
                var cantidad = Model.Carrito.Items.FirstOrDefault(i => i.IdPizza == pizza.IdPizza)?.Cantidad ?? 0;
                <div class="col-md-6">
                    <div class="card card-pizza h-100">
                        <img src="@pizza.ImagenUrl" alt="@pizza.Nombre" class="pizza-img" />
                        <div class=" card-body d-flex flex-column">
                            <h5 class="fw-bold mb-1">@pizza.Nombre</h5>
                            <p class="text-muted mb-3">@pizza.Descripcion</p>

                            <div class="d-flex justify-content-between align-items-center mt-auto flex-wrap gap-2">
                                <span class="precio">@pizza.Precio.ToString("C0", new System.Globalization.CultureInfo("es-AR"))</span>

                                <div class="qty-pill">
                                    <button type="button" class="btn-qty" data-id="@pizza.IdPizza" data-delta="-1" title="Quitar una">−</button>
                                    <span class="qty-val" data-id="@pizza.IdPizza">@cantidad</span>
                                    <button type="button" class="btn-qty" data-id="@pizza.IdPizza" data-delta="1" title="Agregar una">+</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="cart-sidebar" id="carrito">
            @await Html.PartialAsync("_Carrito", Model.Carrito)
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/carrito.js" asp-append-version="true"></script>
}
