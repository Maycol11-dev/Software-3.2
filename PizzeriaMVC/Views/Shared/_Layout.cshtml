<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pizza Brava</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="~/images/bravaIcon.jpg"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PizzeriaMVC.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark navbar-pizzeria">
            <div class="container">
                <a class="navbar-brand brand-logo" asp-controller="Home" asp-action="Index">
                    <span>🍕</span> Pizza Brava
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Menu" asp-action="Menu">Menú</a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown ms-sm-2">
                                <a class="nav-link dropdown-toggle btn btn-sm btn-outline-light rounded-pill px-3 py-1 text-white d-flex align-items-center gap-2"
                                   href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span>👤</span>
                                    <span>@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="userDropdown">
                                    <li class="px-3 py-2 text-muted small border-bottom mb-1">
                                        Conectado como<br><strong class="text-dark">@User.Identity.Name</strong>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-controller="MisPedidos" asp-action="MisPedidos">
                                            <span>📦</span> Mis pedidos
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <form asp-controller="Cuenta" asp-action="Logout" method="post" class="m-0">
                                            <button type="submit" class="dropdown-item d-flex align-items-center gap-2 py-2 text-danger">
                                                <span>🚪</span> Salir
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-sm-2">
                                <a class="btn btn-sm btn-outline-light rounded-pill px-3 py-1" asp-controller="Cuenta" asp-action="Login">
                                    Ingresar
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container mt-2">
        <main role="main" class="pb-3">
            @if (TempData["MensajeExito"] is string exito)
            {
                <div class="alert alert-success">@exito</div>
            }
            @if (TempData["MensajeError"] is string error)
            {
                <div class="alert alert-danger">@error</div>
            }
            @if (TempData["MensajeInfo"] is string info)
            {
                <div class="alert alert-info">@info</div>
            }
            @RenderBody()
        </main>
    </div>
    <footer class="py-3 mt-2">
        <div class="container text-center">
            🍕 <strong>Pizza Brava</strong> — Tu pedido llega caliente y sin excepciones.
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>