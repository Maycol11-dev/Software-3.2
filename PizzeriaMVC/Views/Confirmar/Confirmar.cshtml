@model PizzeriaMVC.Models.ConfirmarViewModel
@{
    ViewData["Title"] = "Confirmar pedido";
}

@section Styles {
    <link rel="stylesheet" href="~/css/confirmar.css" asp-append-version="true" />
}

<h2 class="titulo-seccion mb-4">✅ Confirmar pedido</h2>

@if (Model.Carrito.Vacio)
{
    <div class="alert alert-warning">Tu carrito está vacío. <a asp-controller="Menu" asp-action="Menu" class="alert-link">Volvé al menú</a> para elegir pizzas.</div>
}
else
{
    <form asp-action="ConfirmarEnvio" method="post">
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="seccion-datos h-100">
                    <h5 class="fw-bold mb-3">🧾 Resumen del pedido</h5>
                    @foreach (var item in Model.Carrito.Items)
                    {
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span>@item.Nombre <small class="text-muted">x @item.Cantidad</small></span>
                            <span class="fw-semibold">@item.Subtotal.ToString("C0", new System.Globalization.CultureInfo("es-AR"))</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between fw-bold resumen-total mt-3 pt-2">
                        <span>Total</span>
                        <span class="precio">@Model.Carrito.Total.ToString("C0", new System.Globalization.CultureInfo("es-AR"))</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="seccion-datos">
                    <h5 class="fw-bold mb-3">👤 Datos de entrega</h5>

                    <dl class="row mb-4">
                        <dt class="col-sm-4">Nombre</dt>
                        <dd class="col-sm-8">@Model.Nombre</dd>

                        <dt class="col-sm-4">Teléfono</dt>
                        <dd class="col-sm-8">@Model.Telefono</dd>

                        <dt class="col-sm-4">Dirección</dt>
                        <dd class="col-sm-8">@Model.Direccion</dd>
                    </dl>

                    <button type="submit" class="btn btn-pizza-verde btn-lg w-100">Confirmar y enviar a cocina</button>
                </div>
            </div>
        </div>
    </form>
}
