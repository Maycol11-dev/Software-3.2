@model PizzeriaMVC.Models.SeguimientoViewModel
@{
    ViewData["Title"] = "Seguimiento del pedido";
}

@section Styles {
    <link rel="stylesheet" href="~/css/seguimiento.css" asp-append-version="true" />
}

<div class="text-center mb-4">
    <div class="hero-pizza" style="font-size:4rem;">🛵</div>
    <h2 class="titulo-seccion">Pedido #@Model.IdPedido</h2>
    <p class="text-muted">
        Total: <strong>@Model.Total.ToString("C0", new System.Globalization.CultureInfo("es-AR"))</strong>
        · Entrega en <strong>@Model.DireccionEntrega</strong>
    </p>
</div>

<div class="seccion-datos py-5 px-3">
    @{
        var alcanzados = Model.Pasos.Count(p => p.Completo);
        // De 1 a 4 pasos: 0% en paso 1 (centrado en el primer círculo), 33% en 2, 66% en 3, 100% en 4.
        var porcentajeProgreso = alcanzados switch
        {
            1 => 0,
            2 => 33.33,
            3 => 66.66,
            4 => 100,
            _ => 0
        };
    }
    <div class="stepper mx-auto" style="max-width: 820px;">
        <div class="progreso" style="width: @(porcentajeProgreso)%"></div>

        @foreach (var paso in Model.Pasos)
        {
            var clase = paso.Completo ? "completo" : "";
            if (paso.Activo) { clase += " activo"; }
            <div class="step @clase">
                <div class="step-circle">
                    @if (paso.Completo && !paso.Activo)
                    {
                        <span>✔</span>
                    }
                    else
                    {
                        <span>@paso.Emoji</span>
                    }
                </div>
                <div class="step-label">@paso.Nombre</div>
            </div>
        }
    </div>
</div>

<div class="row g-4 mt-2">
    <div class="col-md-6">
        <div class="seccion-datos">
            <h5 class="fw-bold titulo-seccion mb-2">👨‍🍳 Estado actual</h5>
            @{
                var actual = Model.Pasos.FirstOrDefault(p => p.Activo) ?? Model.Pasos.LastOrDefault();
                var emoji = actual?.Emoji ?? "🍕";
                var nombre = actual?.Nombre ?? "Desconocido";
            }
            <p class="mb-0">
                <span class="fs-3">@emoji</span> Tu pedido está en: <strong>@nombre</strong>.
            </p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="seccion-datos">
            <h5 class="fw-bold titulo-seccion mb-2">🍕 ¿Qué se preparó?</h5>
            @if (Model.Items.Count > 0)
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var item in Model.Items)
                    {
                        <li class="d-flex justify-content-between align-items-center py-1">
                            <span>@item.Nombre <small class="text-muted">x @item.Cantidad</small></span>
                            <span class="fw-semibold">@item.Subtotal.ToString("C0", new System.Globalization.CultureInfo("es-AR"))</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="mb-0 text-muted">No pudimos obtener el detalle del pedido.</p>
            }
        </div>
    </div>
</div>