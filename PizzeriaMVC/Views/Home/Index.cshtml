@{
    ViewData["Title"] = "Inicio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="hero">
    <div class="container py-5">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <img src="~/images/Inicio.jpg" alt="Pizza recién horneada" class="hero-img" />
            </div>

            <div class="col-lg-6 hero-texto text-center">
                <h1>Tu app pide una pizza...<br />y la API se la entrega</h1>
                <p class="lead mx-auto" style="max-width: 560px;">
                    Elige del menú, confirmá tu pedido y seguí a la cocina trabajando en tiempo real. La pizza más rica de Buenos Aires ¡Ha Llegado!.
                </p>
                <div class="mt-4">
                    <a class="btn btn-pizza btn-lg" asp-controller="Pedidos" asp-action="Menu">🍕 Ver menú</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row g-4 my-4 text-center">
        <div class="col-md-4">
            <div class="card card-pizza h-100 p-4">
                <div class="pizza-tile mb-3">🧾</div>
                <h5 class="fw-bold">Pedís por API REST</h5>
                <p class="mb-0 text-muted">El cliente manda su pedido estructurado y recibe confirmación al instante.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-pizza h-100 p-4">
                <div class="pizza-tile mb-3">👨‍🍳</div>
                <h5 class="fw-bold">La cocina lo prepara</h5>
                <p class="mb-0 text-muted">El backend delega la preparación a un servicio interno por sockets.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-pizza h-100 p-4">
                <div class="pizza-tile mb-3">🛵</div>
                <h5 class="fw-bold">Y llega a tu puerta</h5>
                <p class="mb-0 text-muted">En viaje, entregado: seguí cada estado con la máquina de estados.</p>
            </div>
        </div>
    </div>
</div>