@{
    ViewData["Title"] = "Inicio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="hero">
    <div class="container py-5">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <img src="~/images/Inicio.jpg" alt="Pizza recién horneada" class="hero-img" />
            </div>

            <div class="col-lg-6 hero-texto text-center">
                <h1>Tu pide una pizza<br />y nosotros te la entregamos</h1>
                <p class="lead mx-auto" style="max-width: 560px;">
                    Elige del menú, confirmá tu pedido y seguí a la cocina trabajando en tiempo real. La pizza más rica de Buenos Aires ¡Ha Llegado!
                </p>
                <div class="mt-4">
                    <a class="btn btn-pizza btn-lg" asp-controller="Menu" asp-action="Menu">🍕 Ver menú</a>
                </div>
            </div>
        </div>
    </div>
</div>
