@{
    ViewData["Title"] = "Inicio";
}

<div class="hero text-center">
    <div class="container py-4">
        <div class="hero-pizza">🍕</div>
        <h1 class="mt-3">Tu app pide una pizza...<br />y la API se la entrega</h1>
        <p class="lead mx-auto" style="max-width: 560px;">
            Elige del menú, confirmá tu pedido y seguí a la cocina trabajando en tiempo real: de Espera de confirmación hasta Entregado.
        </p>
        <div class="mt-4">
            <a class="btn btn-pizza btn-lg me-2" asp-controller="Pedidos" asp-action="Menu">🍕 Ver menú</a>
            <a class="btn btn-pizza-verde btn-lg" asp-controller="Pedidos" asp-action="Seguimiento" asp-route-id="123">🛵 Seguir mi pedido</a>
        </div>
    </div>
</div>

<div class="container">
    <div class="row g-4 my-4 text-center">
        <div class="col-md-4">
            <div class="card card-pizza h-100 p-4">
                <div class="pizza-tile mb-3">🧾</div>
                <h5 class="fw-bold">Pedís por API REST</h5>
                <p class="mb-0 text-muted">El cliente manda su pedido estructurado y recibe confirmación al instante.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-pizza h-100 p-4">
                <div class="pizza-tile mb-3">👨‍🍳</div>
                <h5 class="fw-bold">La cocina lo prepara</h5>
                <p class="mb-0 text-muted">El backend delega la preparación a un servicio interno por sockets.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-pizza h-100 p-4">
                <div class="pizza-tile mb-3">🛵</div>
                <h5 class="fw-bold">Y llega a tu puerta</h5>
                <p class="mb-0 text-muted">En viaje, entregado: seguí cada estado con la máquina de estados.</p>
            </div>
        </div>
    </div>
</div>